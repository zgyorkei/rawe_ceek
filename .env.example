# Copied to .env (never committed) for npm run dev. On Vercel the same names go in the project's settings
# (Settings > Environment Variables), never in a file of the repository.

# The Firebase web config (Firebase console > Project settings > Your apps > the web app). Public by design: it is in
# the page, and the Firestore rules (firestore.rules) are what guard the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# a named Firestore database; empty for the project's (default) one
VITE_FIREBASE_DATABASE_ID=

# Server keys: read at run time by api/ (Vercel) and server.ts (here), never a VITE_ variable, never in the page.
EXAMPLE_API_KEY=

# npm run app: the address the app window opens (the Vercel site once it is up); empty for http://127.0.0.1:<port>/
APP_URL=
